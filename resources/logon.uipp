








































































































































































































































































 






  








   






































































































































 















































  








   
























































































































<duixml>
	<stylesheets>
			
			<style resid="CheckboxStyle">
				<element background="argb(0, 0, 0, 0)" foreground="white" fontface="Tahoma"/>
				<if id="atom(Checkbox)">
					<button width="sysmetric(71)" height="sysmetric(72)" margin="rect(0rp, 0rp, 5rp, 0rp)"/>
					<if keyfocused="true">
						<button contentalign="focusrect"/>
					</if>
				</if>
				<if id="atom(Label)">
					<button width="sysmetric(71)" height="sysmetric(72)" margin="rect(0rp, 0rp, 5rp, 0rp)"/>
				</if>
			</style>
			
			<style resid="CommandlinkStyle">
				<if class="Link">
					<AdvisableButton font="9;normal;shadow|underline;Tahoma" shadowintensity="75" cursor="hand" contentalign="middleleft"/>
					<if keyfocused="true">
						<button contentalign="middlecenter|focusrect"/>
					</if>
					<if mousefocused="true">
						<button fontstyle="underline"/>
					</if>
				</if>
				<if class="StaticText">
                	<AdvisableElement font="9;normal;shadow;Tahoma" shadowintensity="75" contentalign="WrapLeft"/>

                </if>
			</style>
			
			<style resid="CommandLinks">
				<button layoutpos="top" cursor="hand" contentalign="middleleft" content="resbmp(128,3,-1,28rp,29rp,0,0)" padding="rect(5rp,0,11rp,0)" margin="rect(0rp, 0rp, 0rp, 6rp)" background="argb(0,255,0,0)" accessible="true" accrole="43" minsize="size(190rp,30rp)" bordercolor="gray" borderstyle="raised"/>
				<element foreground="white" fontface="franklin gothic medium" font="14.25pt" fontstyle="None" contentalign="MiddleCenter" padding="rect(29rp,7rp,0rp,7rp)" background="argb(0,0,255,0)" />
				<RichText foreground="white" fontface="franklin gothic medium" font="14.25pt" fontstyle="None" contentalign="MiddleCenter" padding="rect(29rp,7rp,0rp,7rp)" background="argb(0,0,255,0)" />
				<if keyfocused="true">
					<button cursor="hand" content="resbmp(128,3,-1,28rp,29rp,0,0)" />
					<element fontface="franklin gothic medium" fontstyle="underline"/>
					<RichText fontface="franklin gothic medium" fontstyle="underline"/>
				</if>
				<if mousefocused="true">
					<button cursor="hand" content="resbmp(128,3,-1,28rp,29rp,0,0)" />
					<element fontface="franklin gothic medium" fontstyle="underline"/>
					<RichText fontface="franklin gothic medium" fontstyle="underline"/>
				</if>
				<if pressed="true">
					<button content="resbmp(129,3,-1,28rp,29rp,0,0)" />
				</if>
				<if class="CancelLink">
					<button cursor="hand" layoutpos="top" contentalign="middleleft" content="resbmp(130,3,-1,28rp,29rp,0,0)" padding="rect(5rp,0,11rp,0)" margin="rect(0rp, 18rp, 0rp, 0rp)" accessible="true" accrole="43" minsize="size(190rp,30rp)" bordercolor="gray" borderstyle="raised"/>
					<element foreground="white" contentalign="MiddleCenter" padding="rect(29rp,7rp,0rp,7rp)"/>
					<RichText foreground="white" contentalign="MiddleCenter" padding="rect(29rp,7rp,0rp,7rp)"/>
					<if keyfocused="true">
						<button cursor="hand" content="resbmp(130,3,-1,28rp,29rp,0,0)" />
						<element fontface="franklin gothic medium" fontstyle="underline"/>
						<RichText fontface="franklin gothic medium" fontstyle="underline"/>
					</if>
					<if mousefocused="true">
						<button cursor="hand" content="resbmp(130,3,-1,28rp,29rp,0,0)" />
						<element fontface="franklin gothic medium" fontstyle="underline"/>
						<RichText fontface="franklin gothic medium" fontstyle="underline"/>
					</if>
					<if pressed="true">
						<button cursor="hand" content="resbmp(131,3,-1,28rp,29rp,0,0)" />
					</if>
				</if>
			</style>
			<style resid="GenericButtons">
			    <button background="themeable(argb(0, 0, 0, 0),window)"/>
			    <element background="argb(0, 0, 0, 0)" fontstyle="None" font="gtf(FLYOUTSTYLE, 4, 1)"/>
			    <expando background="argb(0, 0, 0, 0)"/>
			    <if keyfocused="true">
			    	<button contentalign="focusrect"/>
			    	<element contentalign="wrapleft | endellipsis"/>
			    </if>
			    <if class="pushbutton">
				    <button minsize="size(93rp,28rp)" background="dtb(Button, 1, 1)" padding="rect(4rp,4rp,4rp,4rp)" contentalign="middlecenter" foreground="buttontext"/>
				    <if keyfocused="true">
					    <button contentalign="middlecenter | focusrect"/>
				    </if>
				    <if selected="true">
					    <button background="dtb(Button, 1, 5)"/>
				    </if>
				    <if mousefocused="true">
					    <button background="dtb(Button, 1, 2)"/>
				    </if>
				    <if pressed="true">
					    <button background="dtb(Button, 1, 3)"/>
				    </if>
				    <if enabled="false">
					    <button background="dtb(Button, 1, 4)" foreground="graytext"/>
				    </if>
			    </if>

			</style>
			<style resid="framess">
				<element background="argb(0,0,0,0)"/>
				<if id="atom(contentcontainer)">
					<element background="rgb(90,126,220)"/>
				</if>
				<button background="resbmp(112,6,0xFF0FF,0,0,0,0)" borderthickness="rect(8,8,0,8)"/>
			</style>
			<style resid="toppanelss">
				<element background="argb(0,0,0,0)"/>
				<if id="atom(toppanel)">
					
					<element background="rgb(0,48,156)" padding="rect(25rp, 0rp, 25rp, 20rp)"/>
				</if>
				<if id="atom(divider)">
					<element background="resbmp(125,6,0xFF0FF,0,0,0,0)"/>
				</if>
				<if id="atom(time)">
					<element foreground="white" fontface="franklin gothic medium" fontsize="24pt"/>
				</if>
				<if id="atom(date)">
					<element foreground="white" fontface="tahoma" fontsize="9pt"/>
				</if>
			</style>
			<style resid="bottompanelss">
				<element background="argb(0,0,0,0)"/>
				<if id="atom(bottompanel)">
					<element background="gradient(argb(0,57,52,173), argb(0,0,48,156), 0)" fontface="resstr(2)"/>
				</if>
				<if id="atom(divider)">
					<element background="resbmp(126,6,0xFF0FF,0,0,0,0)"/>
				</if>
				<if id="atom(options)">
					<element padding="rect(25rp, 20rp, 25rp, 20rp)"/>
				</if>
				<button font="resstr(42)" foreground="white" cursor="hand"/>
				<if mousefocused="true">
					<button fontstyle="underline"/>
				</if>
				<if keyfocused="true">
					<button fontstyle="underline"/>
				</if>
				<if id="atom(instruct)">
					<element contentalign="wrapleft" padding="rect(18rp,0,0,0)" font="resstr(43)" foreground="white"/>
				</if>
			</style>
			<style resid="leftpanelss">
				<element background="argb(0,0,0,0)" fontface="resstr(1)"/>
				<if id="atom(product)">
					<element animation="alpha | s | mediumslow"/>
				</if>
				<if id="atom(leftpanel)">
					<element foreground="rgb(239,247,255)"/>
				</if>
				<if id="atom(welcome)">
					<element fontstyle="italic" font="resstr(44)" fontweight="bold" padding="rect(0rp,0rp,22rp,0)" contentalign="topright"/>
				</if>
				<if id="atom(welcomeshadow)">
					<element foreground="rgb(49,81,181)" fontstyle="italic" font="resstr(44)" fontweight="bold" padding="rect(2rp,3rp,20rp,0)" contentalign="topright"/>
				</if>
				<if id="atom(help)">
					<element font="resstr(45)" padding="rect(81rp,81rp,0,0)" contentalign="wrapright"/>
				</if>
			</style>
			<style resid="rightpanelss">
				<element background="argb(0,0,0,0)"/>
				<if id="atom(divider)">
					<element background="resbmp(124,6,0xFF0FF,0,0,0,0)"/>
				</if>
				<if vertical="true">
					<scrollbar layoutpos="nineright" background="rgb(115,146,231)"/>
				</if>
				<viewer layoutpos="nineclient"/>
				<thumb background="resbmp(111,6,0xFF0FF,0,0,0,0)" borderthickness="rect(3,3,3,3)"/>
				<if id="atom(lineup)">
					<repeatbutton content="resbmp(110,3,-1,sysmetric(20),sysmetric(20),0,0)"/>
				</if>
				<if id="atom(linedown)">
					<repeatbutton content="resbmp(109,3,-1,sysmetric(20),sysmetric(20),0,0)"/>
				</if>
			</style>
			<style resid="hotaccountlistss">
				<element background="argb(0,0,0,0)" fontface="resstr(3)"/>
				<selector padding="rect(0rp,26rp,5rp,26rp)"/>
				<logonaccount cursor="hand" foreground="rgb(239,247,255)" background="rgb(90,126,220)" animation="alpha | log | fast" alpha="96"/>
				<if logonstate="1">
					<logonaccount animation="rectangle | s | mediumfast" cursor="arrow" alpha="255"/>
				</if>
				<if mousewithin="true">
					<logonaccount cursor="hand" alpha="255"/>
				</if>
				<if selected="true">
					<logonaccount cursor="hand" alpha="255"/>
				</if>
				<if id="atom(userpane)">
					<element padding="rect(2rp,2rp,14rp,2rp)" borderthickness="rect(5,5,0,5)" bordercolor="rgb(90,126,220)" font="resstr(45)"/>
					<if selected="true">
						<element background="resbmp(112,6,0xFF0FF,0,0,0,0)"/>
					</if>
				</if>
				<if selected="true">
					<logonaccount alpha="255"/>
				</if>
				<if id="atom(pictureframe)">
					<element background="resbmp(113,7,255,0,0,0,0)" borderthickness="rect(5,5,5,5)" margin="rect(0,0, 7rp,0)"/>

					<if mousefocused="true">
						<element background="resbmp(119,7,255,0,0,0,0)" borderthickness="rect(5,5,5,5)" margin="rect(0,0,7rp,0)" alpha="255"/>
					</if>
					<if selected="true">
						<element background="resbmp(119,7,255,0,0,0,0)" borderthickness="rect(5,5,5,5)" margin="rect(0,0,7rp,0)" alpha="255"/>
					</if>
				</if>
				<if id="atom(sas)">
                	<element foreground="rgb(56,68,104)" background="argb(0,0,0,0)" font="resstr(45)"/>
                </if>
				<if id="atom(username)">
					<element foreground="rgb(239,247,255)" contentalign="endellipsis"/>
				</if>
				<if class="status">
					<button background="argb(0,0,0,0)" foreground="rgb(0,48,156)" font="resstr(46)" fontweight="bold"/>
					<if mousefocused="true">
						<button fontstyle="underline"/>
					</if>
					<if keyfocused="true">
						<button fontstyle="underline"/>
					</if>
					<if selected="true">
						<button foreground="rgb(239,247,255)" font="resstr(46)" fontweight="bold"/>
					</if>
				</if>
			</style>
			<style resid="accountlistss">
				<element background="argb(0,0,0,0)" fontface="resstr(3)"/>
				<selector padding="rect(0rp,26rp,5rp,26rp)"/>
				<logonaccount cursor="hand" animation="alpha | log | fast" background="rgb(90,126,220)"/>
				<if logonstate="1">
					<logonaccount animation="rectangle | s | mediumfast" cursor="arrow"/>
				</if>
				<if id="atom(userpane)">
					<element padding="rect(2rp,2rp,14rp,2rp)" borderthickness="rect(5,5,0,5)" bordercolor="rgb(90,126,220)" font="resstr(45)"/>
					<if selected="true">
						<element background="resbmp(112,6,0xFF0FF,0,0,0,0)"/>
					</if>
				</if>
				<if id="atom(pictureframe)">
					<element background="resbmp(113,7,255,0,0,0,0)" borderthickness="rect(5,5,5,5)" margin="rect(0,0,7rp,0)"/>
				</if>
				<if id="atom(username)">
					<element foreground="rgb(239,247,255)" contentalign="endellipsis"/>
				</if>
				<if class="status">
					<button background="argb(0,0,0,0)" foreground="rgb(0,48,156)" font="resstr(46)" fontweight="bold" contentalign="wrapleft"/>

					<if mousefocused="true">
						<button fontstyle="underline"/>
					</if>
					<if keyfocused="true">
						<button fontstyle="underline"/>
					</if>
					<if selected="true">
						<button foreground="rgb(239,247,255)" font="resstr(46)" fontweight="bold"/>
					</if>
				</if>
			</style>
			<style resid="passwordpaness">
				<element background="argb(0,0,0,0)"/>
				<RestrictedEdit background="resbmp(102,6,16711935,0,0,0,0)" borderthickness="rect(3,3,5,5)" fontface="arial" font="16pt"/>
				<if id="atom(passwordpanelayer)">
					<element padding="rect(71rp,34rp,0,0)"/>
				</if>
				<if id="atom(instruct)">
					<element fontface="resstr(48)" font="resstr(47)" foreground="white" padding="rect(3rp,0,0,3rp)"/>
				</if>
				<if class="PasswordEdit">
					<RestrictedEdit background="resbmp(102,6,16711935,0,0,0,0)" borderthickness="rect(3,3,5,5)" passwordcharacter="9679" fontface="arial" font="16pt"/>
				</if>
				<if id="atom(go)">
					<SubmitButton margin="rect(5rp,0,0,0)" content="resbmp(103,3,-1,26rp,26rp,0,0)" padding="rect(0rp,1rp,0,1rp)"/>

					<if keyfocused="true">
						<SubmitButton content="resbmp(104,3,-1,26rp,26rp,0,0)"/>
					</if>
				</if>
				<if id="atom(info)">
					<button margin="rect(5rp,0,0,0)" content="resbmp(105,3,-1,28rp,28rp,0,0)"/>
					<if keyfocused="true">
						<button content="resbmp(105,3,-1,28rp,28rp,0,0)"/>
					</if>
				</if>
				<if id="atom(keyboard)">
					<element cursor="arrow" margin="rect(5rp,0,0,0)"/>
				</if>
			</style>
			<style resid="scroller">
				<scrollbar layoutpos="ninebottom"/>
				<if vertical="true">
					<scrollbar layoutpos="nineright"/>
				</if>
				<viewer layoutpos="nineclient"/>
				<thumb background="dtb(ScrollBar, 3, 1)" content="dtb(ScrollBar, 9, 1)" contentalign="middlecenter"/>
				<if mousefocused="true">
					<thumb background="dtb(ScrollBar, 3, 2)" content="dtb(ScrollBar, 9, 2)"/>
				</if>
				<if captured="true">
					<thumb background="dtb(ScrollBar, 3, 3)" content="dtb(ScrollBar, 9, 3)"/>
				</if>
				<if id="atom(lineup)">
					<repeatbutton background="dtb(ScrollBar, 1, 1)" width="sysmetric(2)" height="sysmetric(20)"/>
					<if mousefocused="true">
						<repeatbutton background="dtb(ScrollBar, 1, 2)"/>
					</if>
					<if pressed="true">
						<repeatbutton background="dtb(ScrollBar, 1, 3)"/>
					</if>
				</if>
				<if id="atom(linedown)">
					<repeatbutton background="dtb(ScrollBar, 1, 5)" width="sysmetric(2)" height="sysmetric(20)"/>
					<if mousefocused="true">
						<repeatbutton background="dtb(ScrollBar, 1, 6)"/>
					</if>
					<if pressed="true">
						<repeatbutton background="dtb(ScrollBar, 1, 7)"/>
					</if>
				</if>
				<if id="atom(pageup)">
					<repeatbutton background="dtb(ScrollBar, 7, 1)"/>
					<if mousefocused="true">
						<repeatbutton background="dtb(ScrollBar, 7, 2)"/>
					</if>
					<if pressed="true">
						<repeatbutton background="dtb(ScrollBar, 7, 3)"/>
					</if>
				</if>
				<if id="atom(pagedown)">
					<repeatbutton background="dtb(ScrollBar, 6, 1)"/>
					<if mousefocused="true">
						<repeatbutton background="dtb(ScrollBar, 6, 2)"/>
					</if>
					<if pressed="true">
						<repeatbutton background="dtb(ScrollBar, 6, 3)"/>
					</if>
				</if>
			</style>
	</stylesheets>






	<logonframe resid="main" id="atom(frame)" sheet="framess" layout="borderlayout()">

		<element id="atom(toppanel)" sheet="toppanelss" layout="borderlayout()" padding="rect(0rp, 0rp, 0rp, 0rp)" layoutpos="top" height="80rp">
			<element id="atom(divider)" layoutpos="bottom" padding="rect(0rp, 0rp, 0rp, 0rp)" height="2rp" />
			<element id="atom(dateandtime)" layout="borderlayout()" layoutpos="right" padding="rect(25rp, 0rp, 25rp, 20rp)" contentalign="bottomright">
				<element id="atom(date)" content="Monday, September 23, 2002"/>
				<element id="atom(time)" content="1:38 PM"/>
			</element>
		</element>

		<element id="atom(bottompanel)" sheet="bottompanelss" layout="borderlayout()" layoutpos="bottom">
			<element id="atom(divider)" layoutpos="top" height="2rp" />
			<element id="atom(options)" layout="borderlayout()" layoutpos="client">
				<element layout="borderlayout()" layoutpos="left">
					<button id="atom(power)" layout="borderlayout()" layoutpos="top" accessible="true" accRole="43" accName="resstr(11)">
						<element layoutpos="left" content="resbmp(107,3,-1,26rp,26rp,0,0)"  />
						<element id="atom(label)" layoutpos="client" margin="rect(2rp,0,0,0)" />
					</button>
					<button id="atom(undock)" layout="borderlayout()" layoutpos="top" margin="rect(0,2rp,0,0)" accessible="true" accRole="43" accName="resstr(14)">
						<element layoutpos="left" content="resbmp(108,3,-1,26rp,26rp,0,0)" />
						<element id="atom(label)" layoutpos="client" margin="rect(2rp,0,0,0)" />
					</button>
				</element>
				<element id="atom(instruct)" layoutpos="right" content="resstr(25)" width="325rp" />
			</element>
		</element>

		<element id="atom(contentcontainer)" layout="flowlayout(1,3,2,3)" layoutpos="client" content="resbmp(100,0,0,219rp,207rp,0,0)">
			<element id="atom(leftpanel)" sheet="leftpanelss" layout="filllayout()" layoutpos="left">
				<element id="atom(logoarea)" layout="verticalflowlayout(0,3,3,2)">
					<element id="atom(product)" contentalign="topright" padding="rect(0rp,0rp,20rp,20rp)" content="resbmp(123,3,-1,137,86,0,0)" background="rgb(90,126,220)" />
					<element id="atom(help)" contentalign="wrapright" width="384rp" padding="rect(0rp,0rp,40rp,0rp)" />
				</element>
				<element id="atom(msgarea)" layout="verticalflowlayout(0,0,0,2)" >
					<element layout="filllayout()" width="384rp">
						<element id="atom(welcomeshadow)" content="resstr(7)" />
						<element id="atom(welcome)" content="resstr(7)" />
					</element>
				</element>
			</element>

			<element id="atom(rightpanel)" sheet="rightpanelss" layout="borderlayout()" layoutpos="left" width="384rp">
				<element id="atom(divider)" layoutpos="left" width="1rp" />
				<styledscrollviewer id="atom(scroller)" sheet="scroller" layoutpos="left" xscrollable="false" margin="rect(26rp,0rp,0rp,0rp)">
					<logonaccountlist id="atom(accountlist)" sheet="accountlistss" layout="verticalflowlayout(0,3,3,2)" />
				</styledscrollviewer>
				<element id="atom(sas)" sheet="hotaccountlistss" layout="borderlayout()" layoutpos="none" padding="rect(20rp,0rp,0rp,0rp)" accessible="true" accName="resstr(50)">
                	<element id="atom(keyboardicon)" layoutpos="left" contentalign="middlecenter" width="58rp" height="58rp" layout="flowlayout(0,2,2)"/>
                	<element id="atom(username)" layoutpos="left" contentalign="middlecenter" content="resstr(50)"/>
                </element>
				<styledscrollviewer id="atom(SecurityOptions)" sheet="scroller" xscrollable="false" layoutpos="client" visible="false">
					<element layout="verticalflowlayout(0,0,0,2)" sheet="CommandLinks" padding="rect(5rp, 9rp, 0rp, 9rp)">
						<button id="atom(SecurityLock)" accname="resstr(1801)" layoutpos="none" layout="flowlayout()" class="SecurityCommandLink">
							<element content="resstr(1801)" shortcut="auto"/>
						</button>
						<button id="atom(SecuritySwitchUser)" accname="resstr(1807)" layoutpos="none" layout="flowlayout()" class="SecurityCommandLink">
							<element content="resstr(1807)" shortcut="auto"/>
						</button>
						<button id="atom(SecurityLogOff)" accname="resstr(1803)" layoutpos="none" layout="flowlayout()" class="SecurityCommandLink">
							<element content="resstr(1803)" shortcut="auto"/>
						</button>
						<button id="atom(SecurityChange)" accname="resstr(1804)" layoutpos="none" layout="flowlayout()" class="SecurityCommandLink">
							<element content="resstr(1804)" shortcut="auto"/>
						</button>
						<button id="atom(SecurityTaskManager)" accname="resstr(1805)" layoutpos="none" layout="flowlayout()" class="SecurityCommandLink">
							<element content="resstr(1805)" shortcut="auto"/>
						</button>
						<button id="atom(CancelSecurityOptions)" accname="resstr(1806)" layoutpos="none" layout="flowlayout()" class="CancelLink">
							<element content="resstr(1806)" shortcut="auto" class="CancelLink"/>
						</button>
						<element id="atom(DialogButtons)" layout="flowlayout(0,1,2,2)" layoutpos="none" sheet="GenericButtons" padding="rect(0rp, 10rp, 0rp, 0rp)" margin="rect(0rp, 30rp, 0rp, 5rp)">
						    <button margin="rect(0rp, 0rp, 0rp, 6rp)" layout="flowlayout(0,2,2,2)" active="keyboard|mouse" accessible="true" accrole="pushbutton" class="pushbutton">
						        <element padding="rect(8rp,0rp,8rp,0rp)" shortcut="auto" content="OK" foreground="buttontext"/>
				            </button>
						    <button margin="rect(0rp, 0rp, 0rp, 6rp)" layout="flowlayout(0,2,2,2)" active="keyboard|mouse" accessible="true" accrole="pushbutton" class="pushbutton">
						        <element padding="rect(8rp,0rp,8rp,0rp)" shortcut="auto" content="resstr(1806)" foreground="buttontext"/>
						    </button>
						</element>

					</element>
				</styledscrollviewer>
			</element>

		</element>

	</logonframe>





	<logonaccount resid="accountitem" id="atom(accountitem)" layout="filllayout()" accessible="true" accRole="43">
		<element id="atom(userpanelayer)" layout="borderlayout()" height="80rp" layoutpos="top">
			<element id="atom(userpane)" layout="borderlayout()" layoutpos="top">
				<element id="atom(pictureframe)" layout="flowlayout(0,2,2)" layoutpos="left" width="58rp" height="58rp">
				   <element id="atom(picture)"  />
				</element>
				<element id="atom(username)" layoutpos="top" />
				<button id="atom(status0)" class="status" layoutpos="none" />
				<button id="atom(status1)" class="status" layoutpos="none" />
			</element>
		</element>
		<element id="atom(passwordpanelcontainer)" layout="verticalflowlayout(0,0,2)"/>
	</logonaccount>





	<element resid="editcontrol" layout="borderlayout()" layoutpos="bottom">
		<RestrictedEdit id="atom(password)" layoutpos="left" height="29rp" width="163rp" />
		<element id="atom(keyboard)" layoutpos="left" />
		<SubmitButton id="atom(go)" visible="false" layoutpos="left" accessible="true" accRole="43" accName="resstr(100)" />
